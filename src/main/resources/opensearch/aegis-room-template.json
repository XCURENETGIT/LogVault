{
	"index_patterns": [
		"aegis-room"
	],
	"priority": 9999999,
	"template": {
		"settings": {
			"max_result_window": 5000,
			"index.codec": "best_compression",
			"index": {
				"number_of_shards": 1,
				"number_of_replicas": 0,
				"codec": "best_compression",
				"highlight": { "max_analyzed_offset": 2000000 },
				"analysis": {
					"filter": {
						"prefix_edge_ngram_filter": {
							"type": "edge_ngram",
							"min_gram": 2,
							"max_gram": 30
						}
					},
					"analyzer": {
						"index_analyzer": {
							"tokenizer": "whitespace",
							"filter": [
								"lowercase",
								"prefix_edge_ngram_filter"
							]
						},
						"search_analyzer": {
							"tokenizer": "whitespace",
							"filter": [
								"lowercase"
							]
						}
					}
				}
			}
		},
		"mappings": {
			"properties": {
				"room_id" : {
					"type": "keyword"
				},
				"action": {
					"type": "keyword"
				},
				"reason": {
					"type": "keyword"
				},
				"rule_seq": {
				  	"type": "integer"
				},
				"rule_name": {
				  	"type": "keyword"
				},
				"rule_target": {
					"type": "keyword"
				},
				"block_extension": {
				  "type": "keyword"
				},
				"@timestamp": {
					"type": "date",
					"format": "epoch_millis"
				},
				"recent_ctime": {
					"type": "date",
					"format": "yyyyMMddHHmmss"
				},
				"day": {
					"properties": {
						"week": {
							"type": "integer"
						},
						"work": {
							"type": "keyword"
						}
					}
				},
				"recent_msgid" : {
					"type": "keyword"
				},
				"ml_result": {
					"properties": {
						"code_exist": {
							"type": "boolean"
						},
						"category": {
							"type": "integer"
						},
						"probs": {
							"type": "float"
						},
						"keywords": {
							"type": "keyword"
						},
						"result": {
							"type": "integer"
						},
						"message": {
							"type": "keyword"
						}
					}
				},
				"guardrail_category": {
				  "type": "keyword"
				},
				"svc": {
					"type": "keyword"
				},
				"svc3": {
				  "type": "keyword"
				},
				"recent_message" : {
					"type": "text",
					"analyzer": "index_analyzer",
					"search_analyzer": "search_analyzer"
				},
				"user": {
					"properties": {
						"ip": {
							"type": "ip"
						},
						"id": {
							"type": "keyword"
						},
						"name": {
							"type": "keyword"
						},
						"is_ceo": {
							"type": "boolean"
						},
						"dept_code": {
							"type": "keyword"
						},
						"dept_name": {
							"type": "keyword"
						},
						"jikgub_code": {
							"type": "keyword"
						},
						"jikgub_name": {
							"type": "keyword"
						},
						"proxy_port": {
							"type": "integer"
						},
						"account": {
							"type": "keyword"
						},
						"is_company_account": {
							"type": "boolean"
						}
					}
				},
				"privacy_total": {
					"type": "integer"
				},
				"privacy_info": {
					"type": "nested",
					"properties": {
						"id": {
							"type": "keyword"
						},
						"type": {
							"type": "keyword"
						},
						"attach_name": {
							"type": "keyword"
						},
						"privacy_data": {
							"type": "keyword",
							"doc_values": false,
							"index": false
						},
						"count": {
							"type": "integer"
						},
					  	"blocked": {
							"type": "boolean"
						}
					}
				},
				"anomaly_score": {
					"properties": {
						"guardrail": {
							"properties": {
								"score": { "type": "integer" },
								"count": { "type": "integer" }
							}
						},
						"keyword": {
							"properties": {
								"score": { "type": "integer" },
								"count": { "type": "integer" }
							}
						},
						"pattern": {
							"properties": {
								"score": { "type": "integer" },
								"count": { "type": "integer" }
							}
						},
						"code_exist": {
							"properties": {
								"score": { "type": "integer" },
								"count": { "type": "integer" }
							}
						},
						"similarity": {
							"properties": {
								"score": { "type": "integer" },
								"count": { "type": "integer" }
							}
						},
						"image_similarity": {
							"properties": {
								"score": { "type": "integer" },
								"count": { "type": "integer" }
							}
						},
						"attach": {
							"properties": {
								"score": { "type": "integer" },
								"count": { "type": "integer" }
							}
						},
						"account": {
							"properties": {
								"score": { "type": "integer" },
								"count": { "type": "integer" }
							}
						},
						"work": {
							"properties": {
								"score": { "type": "integer" },
								"count": { "type": "integer" }
							}
						},
						"total": {
							"properties": {
								"score": { "type": "integer" },
								"count": { "type": "integer" }
							}
						}
					}
				},
				"keyword_total": {
					"type": "integer"
				},
				"keyword_info": {
					"properties": {
						"exist": {
							"type": "boolean"
						},
						"keywords": {
							"type": "nested",
							"properties": {
								"name": {
									"type": "keyword"
								},
								"count": {
									"type": "integer"
								},
							  	"blocked": {
									"type": "boolean"
							  	}
							}
						},
						"attach": {
							"type": "nested",
							"properties": {
								"name": {
									"type": "keyword"
								},
								"count": {
									"type": "integer"
								},
								"blocked": {
								  	"type": "boolean"
								}
							}
						},
						"attach_name": {
							"type": "nested",
							"properties": {
								"name": {
									"type": "keyword"
								},
								"count": {
									"type": "integer"
								},
								"blocked": {
								  	"type": "boolean"
								}
							}
						},
						"body": {
							"type": "nested",
							"properties": {
								"name": {
									"type": "keyword"
								},
								"count": {
									"type": "integer"
								},
								"blocked": {
								  	"type": "boolean"
								}
							}
						}
					}
				}
			}
		},
		"aliases": {
			"room-emass": {}
		}
	}
}
