{
	"index_patterns": [
		"emass-*"
	],
	"priority": 9999999,
	"template": {
		"settings": {
			"max_result_window": 5000,
			"index.codec": "best_compression",
			"index": {
				"number_of_shards": 1,
				"number_of_replicas": 0,
				"codec": "best_compression",
				"highlight": { "max_analyzed_offset": 2000000 },
				"opendistro.index_state_management.policy_id": "emass_policy",
				"analysis": {
					"filter": {
						"prefix_edge_ngram_filter": {
							"type": "edge_ngram",
							"min_gram": 2,
							"max_gram": 30
						}
					},
					"analyzer": {
						"index_analyzer": {
							"tokenizer": "whitespace",
							"filter": [
								"lowercase",
								"prefix_edge_ngram_filter"
							]
						},
						"search_analyzer": {
							"tokenizer": "whitespace",
							"filter": [
								"lowercase"
							]
						}
					}
				}
			}
		},
